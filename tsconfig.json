{
	"$schema": "https://www.schemastore.org/tsconfig",
	"_version": "23.0.0",

	"compilerOptions": {
		"lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator", "ESNext.Promise"],
		"module": "commonjs",
		"target": "es2024",
		"strict": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"skipLibCheck": true,
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
}
